// web location of the content host's dispatch files (dispatch.client.loader.js, DispatchHost.html, etc.)
DispatchRoot = 'https://crowdstrike.contentcontroller.com/ScormEngineInterface/dispatch/';

// version of dispatch
DispatchVersion = 1;

// web location of the content host's launch process which ultimately leads to the content host Engine launch URL
ContentURL = 'https://crowdstrike.contentcontroller.com/api/launch/content/6/6yajUmyojwutCpE6Z2ZOfgTRyIE8?learnerid=LEARNER_ID&fname=LEARNER_FNAME&lname=LEARNER_LNAME&pipeurl=PIPE_URL&redirecturl=REDIRECT_URL_REGISTRATION_ARGUMENT';

// optional web location that provides pre-launch configuration object
PreLaunchConfigurationURL = 'https://crowdstrike.contentcontroller.com/api/launch/config/content/6/6yajUmyojwutCpE6Z2ZOfgTRyIE8';

DebugMode=false;